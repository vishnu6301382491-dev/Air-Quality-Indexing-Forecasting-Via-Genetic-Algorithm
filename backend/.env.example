# Backend Environment Variables
# Copy this file to .env and fill in your values

# ============ Firebase Realtime Database ============
# Get from: https://console.firebase.google.com
# 1. Create a project
# 2. Go to Realtime Database > Create Database
# 3. Copy the database URL below

FIREBASE_URL=https://your-project-id.firebaseio.com

# Firebase credentials file path (download from Firebase Console > Project Settings > Service Accounts)
FIREBASE_CRED_PATH=firebase-credentials.json

# OR paste the entire JSON content as a single line (for deployment)
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}

# ============ OpenWeatherMap API ============
# Get free API key from: https://openweathermap.org/api
API_KEY=your_openweathermap_api_key_here

# ============ WAQI API ============
# Get free API key from: https://aqicn.org/api/
WAQI_API_KEY=your_waqi_api_key_here

# ============ Ambee API ============
# Get free API key from: https://www.ambeedata.com/
AMBEE_API_KEY=your_ambee_api_key_here

# ============ Weather Company API ============
# Get API key from: https://weather.com/
TWC_API_KEY=your_twc_api_key_here

# ============ Azure Maps API (optional) ============
AZURE_MAPS_KEY=your_azure_maps_key_here

# ============ Location Settings ============
# Default: Visakhapatnam, India
LATITUDE=17.6868
LONGITUDE=83.2185

# ============ Server Settings ============
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ============ CORS (Frontend URL) ============
FRONTEND_URL=http://localhost:3000
